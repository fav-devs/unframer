# Reframe exporter controls
REFRAME_RUNTIME_PKG=reframe
REFRAME_BRAND=Reframe
REFRAME_EMIT_BANNER=false
REFRAME_SUPPRESS_INSTALL=true
REFRAME_CLASS_PREFIX=reframe
# Optional: point to local shim so installs resolve without npm registry
# e.g., absolute path or relative to generated outDir
REFRAME_RUNTIME_PATH=../reframe-runtime
REFRAME_REWRITE_IMPORT_TO=reframe
